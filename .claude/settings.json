{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:unit)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(git *)"
    ]
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "gitkraken": {
      "command": "gk",
      "args": ["mcp"]
    }
  }
}
